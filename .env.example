# Required training inputs
export MODEL_PATH=/path/to/lazymem-sft-checkpoint
export TRAIN_FILE=/path/to/train.parquet
export VAL_FILE=/path/to/val.parquet

# Runtime
export PYTHON_BIN=python
export CUDA_VISIBLE_DEVICES=0,1
export OUTPUT_ROOT=outputs

# Single-GPU OpenAI-compatible judge
export LAZYMEM_ACTIVE_RL_JUDGE_BASE_URL=http://127.0.0.1:8022/v1
export LAZYMEM_ACTIVE_RL_JUDGE_MODEL=qwen-32b
export LAZYMEM_ACTIVE_RL_JUDGE_API_KEY=empty

# The final training configuration fixes eta to 0.915 in the launcher.
export LAZYMEM_ACTIVE_RL_LAMBDA_QUAL=0.5
export LAZYMEM_ACTIVE_RL_PHASE2_FORMAT_THRESHOLD=0.99
