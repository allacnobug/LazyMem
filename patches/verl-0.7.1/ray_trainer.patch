+    def _train_reward_metrics_update(self, reward_extra_infos_dict):
+        metric_dict = {}
+
+        def _values(name):
+            vals = reward_extra_infos_dict.get(name, [])
+            if len(vals) == 0:
+                return None
+            try:
+                arr = np.asarray(vals, dtype=np.float64)
+            except (TypeError, ValueError):
+                return None
+            arr = arr[np.isfinite(arr)]
+            return arr if arr.size else None
+
+        mean_keys = (
+            "score",
+            "acc",
+            "g_format",
+            "R_action",
+            "R_judge",
+            "R_length",
+            "raw_inside_gate",
+            "inside_gate_score",
+            "raw_inside_gate_normalized",
+            "score_norm_enabled",
+            "score_norm_scale",
+            "lambda_act",
+            "lambda_judge",
+            "lambda_len",
+            "judge_enabled",
+            "phase_is_judge",
+            "judge_gate_gold_drop_rate",
+            "judge_gate_threshold",
+            "eval_gold_drop_rate",
+            "R_gold",
+            "R_other",
+            "action_reward_gold_drop",
+            "action_reward_other_keep",
+            "gold_drop_gap",
+            "other_keep_gap",
+            "faithfulness",
+            "utility",
+            "constructed_memory_chars",
+            "keep_rate",
+            "over_keep",
+        )
+        count_keys = (
+            "gold_count",
+            "other_count",
+            "gold_keep_count",
+            "gold_drop_count",
+            "other_keep_count",
+            "other_drop_count",
+        )
+
+        for key in mean_keys:
+            arr = _values(key)
+            if arr is not None:
+                metric_dict[f"train-reward/{key}/mean"] = float(np.mean(arr))
+
+        for key in count_keys:
+            arr = _values(key)
+            if arr is not None:
+                metric_dict[f"train-reward/{key}/mean"] = float(np.mean(arr))
+                metric_dict[f"train-reward/{key}/sum"] = float(np.sum(arr))
+
+        ratio_specs = (
+            ("gold_keep_rate", "gold_keep_count", "gold_count"),
+            ("gold_drop_rate", "gold_drop_count", "gold_count"),
+            ("other_keep_rate", "other_keep_count", "other_count"),
+            ("other_drop_rate", "other_drop_count", "other_count"),
+        )
+        for rate_name, num_name, den_name in ratio_specs:
+            num = _values(num_name)
+            den = _values(den_name)
+            if num is None or den is None:
+                continue
+            num_sum = float(np.sum(num))
+            den_sum = float(np.sum(den))
+            metric_dict[f"train-reward/{rate_name}"] = num_sum / den_sum if den_sum != 0.0 else 0.0
+            raw_rate = _values(rate_name)
+            if raw_rate is not None:
+                valid_rate = raw_rate[raw_rate >= 0.0]
+                if valid_rate.size:
+                    metric_dict[f"train-reward/{rate_name}/sample_mean"] = float(np.mean(valid_rate))
